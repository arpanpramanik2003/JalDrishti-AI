# ==============================================================================
# JalDrishti Backend Environment Configuration Template
# Copy this file to .env and populate with production credentials.
# ==============================================================================

# Application Core Configuration
PROJECT_NAME="JalDrishti AI Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # "development" | "production" | "testing"

# CRITICAL SECURITY SECRETS (MANDATORY - Server will fail to start without these)
# Generate a cryptographically secure 256-bit string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="your_secure_random_jwt_secret_key_here"

# Administrative API Key for triggering batch cron jobs and tariff policy updates (MANDATORY)
ADMIN_API_KEY="your_secure_random_admin_api_key_here"

# Database Configuration (PostgreSQL / Supabase / SQLite)
DATABASE_URL="postgresql://user:password@localhost:5432/jaldrishti"

# Redis Cache & Token Blacklist
REDIS_URL="redis://localhost:6379/0"

# Weather & Soil Remote Sensing APIs
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"
SOILGRIDS_BASE_URL="https://rest.isric.org/soilgrids/v2.0/properties/query"
WEATHER_API_KEY="your_weatherapi_key_here"

# AI / Agri-LLM Groq API
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL_NAME="openai/gpt-oss-20b"

# Firebase Cloud Messaging Service Account (Path to JSON)
FIREBASE_SERVICE_ACCOUNT_PATH="firebase_service_account.json"

# SMS OTP Gateways (Optional for production OTP dispatch)
FAST2SMS_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
